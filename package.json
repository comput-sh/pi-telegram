{
  "name": "@comput/pi-telegram",
  "version": "0.4.0",
  "description": "Use Telegram as a native frontend for live Pi coding-agent sessions.",
  "license": "MIT",
  "author": "Martin Bundgaard",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "telegram",
    "coding-agent"
  ],
  "homepage": "https://github.com/mbundgaard/PiTelegram#readme",
  "bugs": {
    "url": "https://github.com/mbundgaard/PiTelegram/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbundgaard/PiTelegram.git"
  },
  "files": [
    "src/**/*.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.23.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "sharp": "^0.35.4"
  }
}
